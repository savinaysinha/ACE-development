END MODULE;

CREATE COMPUTE MODULE EmployeeManagementSystem_Delete
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- Below Property override the operation property of Looback Request node
		SET OutputLocalEnvironment.Destination.Loopback.Request.operation = 'Delete';
		
		-- Below Property override the Loopback object property of Looback Request node
		SET OutputLocalEnvironment.Destination.Loopback.Request.object = 'employee';
		
		-- Below Property delete a single record based on LoopBack® object ID
		SET OutputLocalEnvironment.Destination.Loopback.Request.id = COALESCE(InputLocalEnvironment.REST.Input.Parameters.id,NULL);
	RETURN TRUE;
	END;
END MODULE;

CREATE COMPUTE MODULE EmployeeManagementSystem_Get
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- Below Property override the operation property of Looback Request node
		SET OutputLocalEnvironment.Destination.Loopback.Request.operation = 'Retrieve';
		
		-- Below Property override the Loopback object property of Looback Request node
		SET OutputLocalEnvironment.Destination.Loopback.Request.object = 'employee';
		
		-- Below Property retrives a single record based on LoopBack® object ID
		SET OutputLocalEnvironment.Destination.Loopback.Request.id = COALESCE(InputLocalEnvironment.REST.Input.Parameters.id,NULL);
		
		--You can use it to set any filter that the connector supports
--		SET OutputLocalEnvironment.Destination.Loopback.Request.filterString = '{"where":{"first_name": "john"}}';
		
		SET OutputLocalEnvironment.Destination.Loopback.Request.filterString = COALESCE(InputLocalEnvironment.HTTP.Input.QueryString.filterString,NULL);
	RETURN TRUE;
	END;
END MODULE;

CREATE COMPUTE MODULE EmployeeManagementSystem_Get_Response
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE inRef REFERENCE TO InputRoot.JSON.Data;
		CREATE LASTCHILD OF OutputRoot.JSON DOMAIN 'JSON' NAME 'Data';
		DECLARE outRef REFERENCE TO OutputRoot.JSON.Data;
		IF FIELDNAME(inRef.[>]) = 'Item' THEN
			SET outRef.employees TYPE = JSON.Array;
			SET outRef.employees = inRef;
		ELSE
			SET outRef = inRef;
		END IF;
	
	
	RETURN TRUE;
	END;
END MODULE;


CREATE COMPUTE MODULE EmployeeManagementSystem_Update
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- Below Property override the operation property of Looback Request node
		SET OutputLocalEnvironment.Destination.Loopback.Request.operation = 'Update';
		
		-- Below Property override the Loopback object property of Looback Request node
		SET OutputLocalEnvironment.Destination.Loopback.Request.object = 'employee';
		
		DECLARE fieldNamesToBeUpdated CHARACTER '';
		
		FOR field AS InputRoot.JSON.Data.[]  DO
			SET fieldNamesToBeUpdated = fieldNamesToBeUpdated || ', ' || FIELDNAME(field);
		END FOR;
		
				
		SET OutputLocalEnvironment.Destination.Loopback.Request.externalIdName = TRIM(LEADING ', ' FROM fieldNamesToBeUpdated);
		SET OutputLocalEnvironment.Destination.Loopback.Request.Id = COALESCE(InputLocalEnvironment.REST.Input.Parameters.id,NULL);
		SET OutputRoot = InputRoot;
		RETURN TRUE;
	END;
END MODULE;

DECLARE employeeCounter SHARED INTEGER 1;
DECLARE counter SHARED INTEGER;
DECLARE isCounterComplete SHARED BOOLEAN false;

CREATE COMPUTE MODULE EmployeeManagementSystem_Create_Bulk_Preparation
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		
		IF EXISTS(InputRoot.JSON.Data.employees[]) THEN
			SET Environment.JSON.Data = InputRoot.JSON.Data;  
		END IF;
		
		DECLARE inRef REFERENCE TO Environment.JSON.Data;
		
		IF EXISTS(inRef.employees.Item[employeeCounter].[]) THEN
			SET OutputRoot.JSON.Data = inRef.employees.Item[employeeCounter];	
			SET employeeCounter  = employeeCounter + 1;
			SET counter = employeeCounter;
		ELSE
			SET isCounterComplete = true;
			SET counter = employeeCounter - 1;
		END IF;
		
		RETURN TRUE;
	END;
END MODULE;


CREATE COMPUTE MODULE EmployeeManagementSystem_Create_Bulk_Computation
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		IF isCounterComplete = true THEN
			IF counter <> 0 THEN
				DECLARE totalEmployeeInserted INTEGER employeeCounter -1;
				CREATE LASTCHILD OF OutputRoot.JSON.Data DOMAIN 'JSON' NAME 'Response';
				DECLARE outRef REFERENCE TO OutputRoot.JSON.Data.Response;
				SET outRef.count = totalEmployeeInserted ;
				SET outRef.InsertedEmployeeRecord TYPE = JSON.Array;
				DECLARE i INTEGER 1;
				FOR record AS Environment.Output.[] DO
					SET outRef.InsertedEmployeeRecord.Item[i] = record;
					SET i = i + 1;	
				END FOR;
				
			ELSE
				SET OutputRoot.JSON.Data.Response.count = 0;
			END IF;
				SET employeeCounter = 1;
				SET isCounterComplete = false;
				SET counter = NULL;
			PROPAGATE TO TERMINAL 'out1';
		ELSE		
			SET Environment.Output.Item[employeeCounter -1] = InputRoot.JSON.Data;
			PROPAGATE TO TERMINAL 'out';
		END IF;
		RETURN FALSE;
	END;
END MODULE;

CREATE FILTER MODULE postBulk_Filter
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		IF isCounterComplete = false THEN
			RETURN TRUE;	
		ELSE
			RETURN FALSE;
		END IF;
		
		
	END;

END MODULE;
